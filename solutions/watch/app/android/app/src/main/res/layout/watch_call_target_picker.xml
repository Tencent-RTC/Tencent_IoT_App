<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watch_call_picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/watch_call_picker_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/watch_call_picker_scrim"
        android:clickable="true"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/watch_call_picker_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/watch_call_picker_surface"
        android:clipToOutline="true"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/watch_call_choose_target"
                android:textColor="@color/watch_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/watch_picker_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:text="@string/watch_cancel"
                android:textColor="@color/watch_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/watch_picker_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/watch_picker_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/watch_call_no_bound_watch"
                android:textColor="@color/watch_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/watch_picker_video_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="44dp"
                    android:background="@drawable/watch_call_picker_video"
                    android:contentDescription="@string/watch_call_video"
                    android:padding="10dp"
                    android:src="@drawable/watch_icon_video" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/watch_call_video"
                    android:textColor="@color/watch_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/watch_picker_voice_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="44dp"
                    android:background="@drawable/watch_call_picker_voice"
                    android:contentDescription="@string/watch_call_voice"
                    android:padding="10dp"
                    android:src="@drawable/watch_icon_phone" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/watch_call_voice"
                    android:textColor="@color/watch_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
