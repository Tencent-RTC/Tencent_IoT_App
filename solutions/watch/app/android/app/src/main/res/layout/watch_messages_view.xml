<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/watch_background" android:orientation="vertical" android:paddingStart="@dimen/watch_space_20" android:paddingTop="@dimen/watch_space_16" android:paddingEnd="@dimen/watch_space_20" android:paddingBottom="@dimen/watch_space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/watch_messages" android:textColor="@color/watch_text_primary" android:textSize="24sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/watch_message_add" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/watch_secondary_button" android:contentDescription="@string/watch_add" android:elevation="2dp" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/watch_icon_add_design" />
        </LinearLayout>
        <EditText android:id="@+id/watch_message_search" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/watch_input" android:drawableStart="@drawable/watch_icon_search_design" android:drawablePadding="10dp" android:hint="@string/watch_search_hint" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="@color/watch_text_primary" android:textColorHint="@color/watch_text_tertiary" android:textSize="13sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/watch_conversation_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="14dp" android:layout_weight="1" android:background="@drawable/watch_card" android:clipToOutline="true" android:elevation="2dp" android:overScrollMode="never" android:paddingTop="4dp" android:paddingBottom="4dp" />
    </LinearLayout>
