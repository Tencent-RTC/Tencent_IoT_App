<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/watch_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/watch_surface">

        <ImageButton
            android:id="@+id/watch_add_contact_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:background="@android:color/transparent"
            android:contentDescription="@string/watch_add_back"
            android:padding="8dp"
            android:src="@drawable/watch_icon_back_design" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/watch_add_page_title"
            android:textColor="@color/watch_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/watch_background"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="38dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingBottom="10dp"
                android:text="@string/watch_add_contact_section"
                android:textColor="@color/watch_add_section_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/watch_add_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <include layout="@layout/watch_add_member_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="67dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/watch_add_divider" />

                <include layout="@layout/watch_add_watch_friend_row" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="6dp"
                android:paddingBottom="10dp"
                android:text="@string/watch_add_group_section"
                android:textColor="@color/watch_add_section_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <include layout="@layout/watch_add_group_row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="6dp"
                android:paddingBottom="10dp"
                android:text="@string/watch_add_watch_section"
                android:textColor="@color/watch_add_section_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <include layout="@layout/watch_add_watch_row" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
