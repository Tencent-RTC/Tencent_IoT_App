<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/watch_location_card_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/watch_bound_watches"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/watch_location_card_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/watch_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/watch_location_card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/watch_location_no_data"
                android:textColor="@color/watch_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="6dp"
            android:layout_height="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/watch_icon_chevron_design" />
    </LinearLayout>
    <TextView
        android:id="@+id/watch_location_card_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/watch_location_no_data"
        android:textColor="@color/watch_text_secondary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/watch_location_card_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/watch_location_no_data"
        android:textColor="@color/watch_text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
