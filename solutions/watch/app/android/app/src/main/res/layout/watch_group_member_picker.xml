<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_background"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/watch_group_picker_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:background="@android:color/transparent"
            android:contentDescription="@string/watch_chat_back"
            android:padding="8dp"
            android:src="@drawable/watch_icon_back_design" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/watch_group_member_picker_title"
            android:textColor="@color/watch_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/watch_group_picker_done"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:gravity="center"
            android:text="@string/watch_group_member_picker_done"
            android:textColor="@color/watch_trust_blue"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>
    <TextView
        android:id="@+id/watch_group_picker_selected"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/watch_text_secondary"
        android:textSize="13sp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:id="@+id/watch_group_picker_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/watch_card"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </ScrollView>
</LinearLayout>
