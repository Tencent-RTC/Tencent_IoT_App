<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/watch_surface">

        <ImageButton
            android:id="@+id/watch_bind_watch_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:background="@android:color/transparent"
            android:contentDescription="@string/watch_bind_watch_back"
            android:padding="10dp"
            android:src="@drawable/watch_icon_back_design" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/watch_surface"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="62dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/watch_bind_watch_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/watch_bind_watch_page_title"
                android:textColor="@color/watch_text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/watch_bind_watch_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_bind_watch_device_label"
                    android:textColor="@color/watch_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/watch_bind_watch_input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/watch_bind_watch_device_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="16"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/watch_text_primary"
                    android:textColorHint="#B0B6C3"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:id="@+id/watch_bind_watch_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/watch_add_divider" />

            <TextView
                android:id="@+id/watch_bind_watch_error"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:textColor="#D72F43"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/watch_bind_watch_submit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/watch_bind_watch_submit"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="@string/watch_bind_watch_submit"
                android:textAllCaps="false"
                android:textColor="@color/watch_surface"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
