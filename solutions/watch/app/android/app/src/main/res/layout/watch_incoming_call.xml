<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watch_incoming_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_call_dark">
    <ImageView
        android:id="@+id/watch_incoming_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/watch_call_avatar_scrim"
        android:contentDescription="@null" />
    <LinearLayout
        android:id="@+id/watch_incoming_nav"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="54dp"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/watch_incoming_nav_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/watch_surface"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/watch_incoming_nav_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/watch_call_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="272dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/watch_incoming_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null"
            android:scaleType="centerInside" />
        <TextView
            android:id="@+id/watch_incoming_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/watch_surface"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/watch_call_dock"
        android:orientation="horizontal"
        android:padding="16dp">
        <TextView
            android:id="@+id/watch_incoming_reject"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/watch_call_action_cancel"
            android:gravity="center"
            android:text="@string/watch_reject"
            android:textColor="@color/watch_surface"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <TextView
            android:id="@+id/watch_incoming_accept"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/watch_call_action_answer"
            android:gravity="center"
            android:text="@string/watch_answer"
            android:textColor="@color/watch_surface"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
