<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/watch_card" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/watch_chat_do_not_disturb" android:textColor="@color/watch_text_primary" android:textSize="14sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/watch_chat_mute_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/watch_chat_do_not_disturb" app:showText="false" app:thumbTint="@color/watch_switch_thumb_tint" app:trackTint="@color/watch_switch_track_tint" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/watch_line" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/watch_chat_pin" android:textColor="@color/watch_text_primary" android:textSize="14sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/watch_chat_pin_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/watch_chat_pin" app:showText="false" app:thumbTint="@color/watch_switch_thumb_tint" app:trackTint="@color/watch_switch_track_tint" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/watch_card" android:gravity="center_vertical" android:paddingStart="16dp" android:text="@string/watch_chat_background" android:textColor="@color/watch_text_primary" android:textSize="14sp" />
    <TextView android:id="@+id/watch_chat_clear_action" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/watch_card" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/watch_chat_clear" android:textColor="@color/watch_alert_red" android:textSize="14sp" />
</LinearLayout>
