<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/watch_lavender" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/watch_trust_blue" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/watch_surface_strong" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/watch_line" />
        </shape>
    </item>
</selector>
