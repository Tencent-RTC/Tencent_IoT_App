<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/watch_space_24"
        android:paddingTop="@dimen/watch_space_20"
        android:paddingEnd="@dimen/watch_space_24"
        android:paddingBottom="@dimen/watch_space_24">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/watch_logo_badge"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/watch_icon_video_design" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/watch_space_10"
                android:text="@string/watch_brand"
                android:textColor="@color/watch_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_space_24"
            android:text="@string/watch_tagline"
            android:textColor="@color/watch_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_space_6"
            android:text="@string/watch_login_subtitle"
            android:textColor="@color/watch_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_space_24"
            android:background="@drawable/watch_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/watch_space_16"
            android:paddingTop="@dimen/watch_space_16"
            android:paddingEnd="@dimen/watch_space_16"
            android:paddingBottom="@dimen/watch_space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_room_label"
                android:textColor="@color/watch_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/watch_room_id"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/watch_space_8"
                android:background="@drawable/watch_input"
                android:drawableStart="@drawable/watch_icon_home_design"
                android:drawablePadding="@dimen/watch_space_8"
                android:hint="@string/watch_room_hint"
                android:inputType="number"
                android:paddingStart="@dimen/watch_space_12"
                android:paddingEnd="@dimen/watch_space_12"
                android:textColor="@color/watch_text_primary"
                android:textColorHint="@color/watch_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_space_12"
                android:text="@string/watch_sdk_app_id_label"
                android:textColor="@color/watch_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/watch_sdk_app_id"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/watch_space_8"
                android:background="@drawable/watch_input"
                android:drawableStart="@drawable/watch_icon_grid_design"
                android:drawablePadding="@dimen/watch_space_8"
                android:hint="@string/watch_sdk_app_id_hint"
                android:inputType="number"
                android:paddingStart="@dimen/watch_space_12"
                android:paddingEnd="@dimen/watch_space_12"
                android:textColor="@color/watch_text_primary"
                android:textColorHint="@color/watch_text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_space_12"
                android:text="@string/watch_sdk_secret_label"
                android:textColor="@color/watch_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/watch_sdk_secret"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/watch_space_8"
                android:background="@drawable/watch_input"
                android:drawableStart="@drawable/watch_icon_lock_design"
                android:drawableEnd="@drawable/watch_icon_eye_design"
                android:drawablePadding="@dimen/watch_space_8"
                android:hint="@string/watch_sdk_secret_hint"
                android:inputType="textPassword"
                android:paddingStart="@dimen/watch_space_12"
                android:paddingEnd="@dimen/watch_space_12"
                android:textColor="@color/watch_text_primary"
                android:textColorHint="@color/watch_text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/watch_login_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/watch_space_14"
            android:background="@drawable/watch_primary_button"
            android:elevation="4dp"
            android:text="@string/watch_login"
            android:textAllCaps="false"
            android:textColor="@color/watch_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_space_24"
            android:gravity="center"
            android:text="@string/watch_other_login"
            android:textColor="@color/watch_text_tertiary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_space_10"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/watch_icon_wechat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/watch_wechat_login"
                    android:textColor="@color/watch_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginStart="@dimen/watch_space_20"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/watch_icon_phone_login_design" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/watch_phone_login"
                    android:textColor="@color/watch_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
