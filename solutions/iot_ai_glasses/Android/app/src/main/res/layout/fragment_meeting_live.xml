<?xml version="1.0" encoding="utf-8"?>
<com.tencent.iot.aiglasses.components.FlowScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <com.tencent.iot.aiglasses.components.SessionHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="会议转录" />

    <com.tencent.iot.aiglasses.components.InlineHint
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone" />

    <com.tencent.iot.aiglasses.features.translation.CaptionTranscript
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <com.tencent.iot.aiglasses.components.LiveControlBar
        android:id="@+id/liveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</com.tencent.iot.aiglasses.components.FlowScreen>
