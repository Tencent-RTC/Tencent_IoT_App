<?xml version="1.0" encoding="utf-8"?>
<com.tencent.iot.aiglasses.components.TabScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:spacing="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.tencent.iot.aiglasses.features.home.Wordmark
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.tencent.iot.aiglasses.components.CircleIconButton
            android:id="@+id/themeToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:circleStyle="raised"
            app:icon="@drawable/icon_moon" />
    </LinearLayout>

    <com.tencent.iot.aiglasses.components.ProductHero
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="176dp" />

    <com.tencent.iot.aiglasses.components.SessionBanner
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/featuresTitle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:accessibilityHeading="true"
            android:gravity="center_vertical"
            android:text="让每一次交流，都有回响。"
            android:textAppearance="@style/TextAppearance.Suisheng"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/featuresSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="AI 功能 · 语音经眼镜采集"
            android:textAppearance="@style/TextAppearance.Suisheng.Caption"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/primaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/secondaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="最近记录"
                android:textAppearance="@style/TextAppearance.Suisheng" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/recentAll"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="查看全部记录"
                android:gravity="center_vertical|end"
                android:minWidth="44dp"
                android:text="全部"
                android:textAppearance="@style/TextAppearance.Suisheng.Caption"
                android:textColor="@color/record_badge_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/recentEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="你的第一条记录，会从这里开始。"
            android:textAppearance="@style/TextAppearance.Suisheng.Caption"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>
</com.tencent.iot.aiglasses.components.TabScreen>
