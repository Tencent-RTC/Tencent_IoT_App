<?xml version="1.0" encoding="utf-8"?>
<com.tencent.iot.aiglasses.components.FlowScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.tencent.iot.aiglasses.components.PageHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:backLabel="返回首页"
        app:title="双向传译" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:id="@+id/languageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.tencent.iot.aiglasses.features.translation.LanguageTrigger
                    android:id="@+id/sourceTrigger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/swapButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="交换语言"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_swap"
                    app:tint="@color/icon_muted" />

                <com.tencent.iot.aiglasses.features.translation.LanguageTrigger
                    android:id="@+id/targetTrigger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.tencent.iot.aiglasses.components.SettingsGroup
                android:id="@+id/settingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <com.tencent.iot.aiglasses.components.SettingRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/menu_record"
                    app:title="保存双语文字">

                    <com.tencent.iot.aiglasses.components.SoftSwitch
                        android:id="@+id/saveSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="保存双语文字" />
                </com.tencent.iot.aiglasses.components.SettingRow>
            </com.tencent.iot.aiglasses.components.SettingsGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/blockedReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Suisheng.Caption"
        android:textColor="@color/danger"
        android:visibility="gone" />

    <com.tencent.iot.aiglasses.components.ActionButton
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:icon="@drawable/icon_mic"
        app:text="开始同传" />
</com.tencent.iot.aiglasses.components.FlowScreen>
