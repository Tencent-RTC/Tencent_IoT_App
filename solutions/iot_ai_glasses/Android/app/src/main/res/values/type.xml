<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Suisheng" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="TextAppearance.Suisheng.Wordmark">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Suisheng.WordmarkCaption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.11</item>
    </style>

    <style name="TextAppearance.Suisheng.PageTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Suisheng.NavTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Suisheng.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Suisheng.Body" />

    <style name="TextAppearance.Suisheng.BodyMedium">
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.Suisheng.Callout">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Suisheng.Footnote">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Suisheng.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Suisheng.CaptionMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.Suisheng.TabLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Suisheng.SheetAction">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Suisheng.SheetTitle">
        <item name="android:textSize">21sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
</resources>
